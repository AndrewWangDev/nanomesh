# ==============================================================================
# NanoMesh-Frontend .gitignore
# ==============================================================================

# Node.js dependencies
node_modules/

# Cloudflare Wrangler local state & development secrets
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Local environment secrets
.env
.env.*
!.env.example

# Production Cloudflare Wrangler config
# Keep local on disk for `npm run deploy` / `wrangler deploy`.
wrangler.toml
!*.example

# Build outputs & TypeScript compilation cache
dist/
build/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store
Thumbs.db

# IDE & Editor configuration
.vscode/
.idea/

# Scratch & temporary repair scripts
fix_*.js
peek*.js
print_*.js
reconstruct.js
rm_*.js
test*.js
tweak_ui.js
js_bubble*.js
