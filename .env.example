# ==============================================================================
# NanoMesh Frontend & Edge Gateway Environment Variables & Secrets
# ==============================================================================
# For local development with `wrangler dev`, copy this file to `.dev.vars`
# For production Cloudflare Workers, set each variable via `wrangler secret put <NAME>`
# ==============================================================================

# --- 1. Authentication & Session Security (Required) ---
# Minimum 32-character random string used to sign and verify user JWT sessions
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string

# Cloudflare Turnstile Captcha Secret Key (Server-side validation)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Widget / Settings
TURNSTILE_SECRET_KEY=0x4AAAAAA...your_turnstile_secret_key_here

# --- 2. Administrative Control (Required for /admin.html) ---
# Admin portal master password
ADMIN_PASSWORD=your_secure_admin_password_here

# --- 3. Transactional Email Service (Resend) ---
# API key from https://resend.com for sending email verification codes
RESEND_API_KEY=re_your_resend_api_key_here

# --- 4. OAuth Social Sign-In (Optional) ---
# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth 2.0 Web Client credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- 5. Cloudflare R2 S3-Compatible API Credentials ---
# Required for generating presigned PUT URLs for client-side direct uploads
# Create an R2 API token with Object Read & Write permissions in Cloudflare Dashboard
Cloudflare_Account_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_s3_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_s3_secret_access_key_here
